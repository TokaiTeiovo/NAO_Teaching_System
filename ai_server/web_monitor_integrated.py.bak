@app.route('/api/processing_logs/<process_id>', methods=['GET'])
def get_processing_logs(process_id):
    """获取处理日志API"""
    try:
        # 查找对应的日志文件
        log_file = LOG_DIR / f"process_{process_id}.log"
        if log_file.exists():
            with open(log_file, 'r', encoding='utf-8') as f:
                logs = f.readlines()
                return jsonify({
                    'success': True,
                    'logs': [line.strip() for line in logs[-100:]]  # 返回最后100行
                })
        else:
            return jsonify({
                'success': False,
                'error': 'Log file not found'
            })
    except Exception as e:
        return jsonify({
            'success': False,
            'error': str(e)
        })


# ==================== 后台处理函数 ====================
def process_pdf_background(process_id, filepath, domain, batch_size, max_pages, import_neo4j, neo4j_config):
    """后台处理PDF"""
    try:
        processing_status[process_id].update({
            'progress': 10,
            'message': '验证PDF文件...'
        })

        # 构建命令
        cmd = [
            sys.executable,
            str(PROJECT_ROOT / "knowledge_extractor" / "knowledge_extractor_integrated.py"),
            "--pdf", filepath,
            "--domain", domain,
            "--batch-size", str(batch_size),
            "--max-items", str(max_pages),
            "--output", f"knowledge_graph_{process_id}.json"
        ]

        if import_neo4j:
            cmd.extend([
                "--import-neo4j",
                "--neo4j-uri", neo4j_config['uri'],
                "--neo4j-user", neo4j_config['user'],
                "--neo4j-password", neo4j_config['password']
            ])

        processing_status[process_id].update({
            'progress': 20,
            'message': 'PDF转图像处理中...'
        })

        logger.info(f"开始处理PDF: {filepath}")
        logger.info(f"处理参数: 领域={domain}, 批次={batch_size}, 最大页数={max_pages}")

        # 执行处理命令
        result = subprocess.run(
            cmd,
            timeout=3600,
            stderr=subprocess.PIPE,
            text=True,
            cwd=PROJECT_ROOT
        )

        if result.returncode == 0:
            logger.info(f"PDF处理完成: {filepath}")
            processing_status[process_id].update({
                'status': 'completed',
                'progress': 100,
                'message': '知识图谱生成完成！',
                'result': {
                    'output_file': f"knowledge_graph_{process_id}.json",
                    'concepts_count': 'N/A',
                    'relations_count': 'N/A',
                    'neo4j_imported': import_neo4j
                }
            })
        else:
            error_msg = result.stderr if result.stderr else 'Processing failed'
            logger.error(f"PDF处理失败: {error_msg}")
            processing_status[process_id].update({
                'status': 'error',
                'error': error_msg
            })

    except subprocess.TimeoutExpired:
        logger.error(f"PDF处理超时: {filepath}")
        processing_status[process_id].update({
            'status': 'error',
            'error': 'Processing timeout (60 minutes exceeded)'
        })
    except Exception as e:
        logger.error(f"PDF处理异常: {e}")
        processing_status[process_id].update({
            'status': 'error',
            'error': str(e)
        })


