    except subprocess.TimeoutExpired:
        logger.error(f"JSON处理超时: {filepath}")
        processing_status[process_id].update({
            'status': 'error',
            'error': 'Processing timeout (30 minutes exceeded)'
        })
    except Exception as e:
        logger.error(f"JSON处理异常: {e}")
        processing_status[process_id].update({
            'status': 'error',
            'error': str(e)
        })


def main():
    """主函数"""
    parser = argparse.ArgumentParser(description="多模态智能教学系统 - 分离版后端API服务器")
    parser.add_argument("--host", type=str, default="127.0.0.1", help="API服务器主机地址")
    parser.add_argument("--port", type=int, default=5000, help="API服务器端口号")
    parser.add_argument("--debug", action="store_true", help="启用调试模式")

    args = parser.parse_args()

    logger.info(f"启动分离版后端API服务器: {args.host}:{args.port}")

    # 启动系统监控
    system_monitor.start_monitoring()

    try:
        logger.info("正在启动Flask API服务器...")
        print(f"\n🔧 多模态智能教学系统 - 后端API服务器")
        print(f"📍 API地址: http://{args.host}:{args.port}")
        print(f"📋 API文档:")
        print(f"   • GET  /api/health - 健康检查")
        print(f"   • POST /api/process_pdf - 处理PDF文件")
        print(f"   • POST /api/process_images - 处理图片文件")
        print(f"   • POST /api/process_json - 处理JSON文件")
        print(f"   • GET  /api/process_status/<id> - 获取处理状态")
        print(f"   • POST /api/test_neo4j - 测试Neo4j连接")
        print(f"   • GET  /api/system_stats - 获取系统状态")
        print(f"   • GET  /api/domains - 获取支持的知识领域")
        print(f"🔧 系统监控已启动")
        print(f"💡 CORS已启用，支持跨域访问")
        print(f"🔧 按 Ctrl+C 退出\n")

        app.run(
            host=args.host,
            port=args.port,
            debug=args.debug,
            threaded=True,
            use_reloader=False
        )

    except KeyboardInterrupt:
        logger.info("收到中断信号，正在关闭服务...")
    except Exception as e:
        logger.error(f"启动API服务器时出错: {e}")
    finally:
        logger.info("后端API服务器已关闭")


if __name__ == "__main__":
    main()